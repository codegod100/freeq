<% bare = ch["name"].to_s.delete("#") %>
<% href = "/chat/#{bare}" %>
<% is_active = active.present? && ch["name"].to_s.casecmp?(active) %>
<li id="sidebar-channel-<%= bare %>" class="sidebar-channel<%= " active" if is_active %>">
  <a href="<%= href %>" class="sidebar-channel-link" data-turbo-prefetch="false"><%= ch["name"] %></a>
  <button type="button" class="sidebar-channel-part" title="Leave channel"
          data-channel="<%= bare %>"
          data-reflex="click->ChatReflex#part">×</button>
  <button type="button" class="sidebar-channel-count" title="Channel policy"
          onclick="event.stopPropagation();window.showPolicy('<%= bare %>')"><%= ch["members"] %></button>
</li>
