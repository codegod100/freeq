<%# Chat shell for a single channel. StimulusReflex handles mutations;
    CableReady broadcasts from the upstream IRC WS bridge morph/append. %>
<div id="freeq-chat"
     data-controller="chat"
     data-channel="<%= @bare %>"
     data-auth-handle="<%= @session.auth.is_a?(Hash) ? @session.auth[:nick] : "" %>">
  <nav>
    <span style="font-size:.875rem;font-weight:700">freeq</span>
    <span style="font-size:.875rem;color:#7ab7ff"><%= @channel %></span>
    <span id="channel-topic" style="margin-left:.5rem;font-size:.7rem;color:var(--muted);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:40%"><%= @topic %></span>
    <div style="margin-left:auto;display:flex;align-items:center;gap:.5rem;font-size:.75rem">
      <% if @session.authenticated? %>
        <span style="color:var(--nick-5)">🔒 <%= @session.auth_handle %></span>
        <form method="POST" action="/logout" style="display:inline">
          <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
          <button type="submit" style="border:0;background:transparent;color:var(--muted);cursor:pointer;font-size:.75rem">Sign out</button>
        </form>
      <% else %>
        <a href="/login" style="color:#7ab7ff;text-decoration:none">Sign in</a>
      <% end %>
      <span id="status"><span class="dot"></span> <span>connecting…</span></span>
    </div>
  </nav>

  <div class="chat-body">
    <%# Sidebar %>
    <aside id="sidebar" data-reflex-permanent>
      <form id="join-form"
            style="display:flex;gap:4px;margin-bottom:.5rem"
            data-reflex="submit->ChatReflex#join"
            data-reflex-serialize-form="true">
        <input
          style="min-width:0;flex:1;border:1px solid var(--border);background:#151a22;border-radius:4px;padding:2px 6px;color:var(--fg)"
          type="text"
          name="channel"
          placeholder="join #…"
          autocomplete="off">
        <button type="submit" style="border:0;border-radius:4px;background:#7ab7ff;color:#0e1116;font-weight:600;padding:2px 8px;cursor:pointer">+</button>
      </form>
      <p class="sidebar-toggle" style="margin:0 0 4px;padding:0 4px;font-size:.65rem;letter-spacing:.04em;color:var(--muted);cursor:pointer">MY CHANNELS</p>
      <ul id="my-channels" style="list-style:none;margin:0 0 12px;padding:0">
        <% @my_channels.each do |ch| %>
          <%= render "chat/channel_link", ch: ch, active: @channel %>
        <% end %>
      </ul>
      <p class="sidebar-toggle collapsed" style="margin:0 0 4px;padding:0 4px;font-size:.65rem;letter-spacing:.04em;color:var(--muted);cursor:pointer">ALL CHANNELS</p>
      <ul id="all-channels" style="list-style:none;margin:0;padding:0;display:none">
        <% @all_channels.each do |ch| %>
          <%= render "chat/channel_link", ch: ch, active: @channel %>
        <% end %>
      </ul>
    </aside>

    <%# Messages + compose — min-height:0 so #messages scrolls instead of growing. %>
    <section class="chat-main">
      <div id="messages" data-reflex-permanent>
        <% @history.each do |msg| %>
          <%= raw(IrcRender.render_history_row(msg, parent_lookup: @parent_lookup)) %>
        <% end %>
      </div>
      <div id="reply-banner" class="reply-banner" data-reflex-permanent></div>
      <form id="send-form"
            data-reflex-permanent
            data-reflex="submit->ChatReflex#send_message"
            data-reflex-serialize-form="true"
            data-channel="<%= @bare %>">
        <input type="hidden" name="reply_to" id="reply-to-input" value="">
        <input
          id="message-input"
          style="min-width:0;flex:1;border:1px solid var(--border);background:#151a22;border-radius:8px;padding:8px 12px;color:var(--fg);font-size:.875rem;outline:none"
          type="text"
          name="msg"
          placeholder="Send to <%= @channel %>…"
          autocomplete="off"
          autofocus>
        <button type="submit" style="border:0;border-radius:8px;background:#7ab7ff;color:#0e1116;font-weight:600;padding:8px 12px;font-size:.875rem;cursor:pointer">Send</button>
        <button id="part-btn"
                type="button"
                style="border:1px solid var(--border);border-radius:8px;background:transparent;color:var(--muted);padding:8px 12px;font-size:.875rem;cursor:pointer"
                data-channel="<%= @bare %>"
                data-reflex="click->ChatReflex#part">×</button>
      </form>
    </section>

    <%# Members %>
    <aside id="member-panel" data-reflex-permanent>
      <% if @members_html %>
        <%= raw(@members_html) %>
      <% else %>
        <div style="color:var(--muted)">—</div>
      <% end %>
    </aside>
  </div>

  <div id="react-picker" role="menu" aria-label="React with emoji"></div>
</div>