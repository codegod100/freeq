<%# Chat shell for a single channel. StimulusReflex handles mutations;
    CableReady broadcasts from the upstream IRC WS bridge morph/append. %>
<div id="freeq-chat"
     data-controller="chat"
     data-channel="<%= @bare %>"
     data-auth-handle="<%= @session.has_credentials? ? @session.auth_handle : "" %>"
     data-auth-nick="<%= @session.has_credentials? ? @session.auth_nick : (@session.current_nick || "") %>"
     data-auth-did="<%= @session.has_credentials? ? @session.auth_did : "" %>"
     data-irc-authenticated="<%= @session.authenticated? %>">
  <nav>
    <%# Channels drawer — visible only ≤1024px; keeps mobile chrome minimal. %>
    <button type="button" class="mobile-btn" id="btn-channels"
            onclick="window.toggleSidebar()" aria-label="Channels" title="Channels">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16"/>
      </svg>
    </button>
    <span class="brand">freeq</span>
    <span class="nav-channel"><%= @channel %></span>
    <span id="channel-topic" title="Click to edit topic"
          style="margin-left:.5rem;font-size:.7rem;color:var(--muted);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:40%;min-width:4rem;cursor:pointer"><%= @topic.presence || "add topic" %></span>
    <form id="topic-form"
          data-reflex="submit->ChatReflex#set_topic"
          data-reflex-serialize-form="true"
          data-channel="<%= @bare %>"
          style="display:none;margin-left:.5rem;flex:0 1 40%;min-width:0">
      <input id="topic-input" type="text" name="topic"
             placeholder="Set topic… (Enter to save, Esc to cancel)"
             autocomplete="off"
             style="width:100%;font-size:.7rem;padding:2px 6px;border:1px solid var(--border);border-radius:4px;background:#151a22;color:var(--fg)">
    </form>
    <div class="nav-right">
      <span id="status"><span class="dot"></span> <span>connecting…</span></span>
      <button type="button" class="mobile-btn" id="btn-members"
              onclick="window.toggleMembers()" aria-label="People" title="People in channel">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M16 19v-1a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v1"/>
          <circle cx="9.5" cy="8" r="3.5"/>
          <path d="M20 19v-1a3.5 3.5 0 0 0-2.5-3.35"/>
          <path d="M16.5 4.6a3.5 3.5 0 0 1 0 6.8"/>
        </svg>
      </button>
    </div>
  </nav>

  <div id="drawer-scrim" onclick="window.closeDrawers()" aria-hidden="true"></div>

  <div class="chat-body">
    <%# Sidebar — desktop column; mobile left sheet via .open %>
    <aside id="sidebar" data-reflex-permanent>
      <p class="drawer-heading">Channels</p>
      <div class="sidebar-scroll">
        <form id="join-form"
              data-reflex="submit->ChatReflex#join"
              data-reflex-serialize-form="true">
          <input
            type="text"
            name="channel"
            placeholder="join #…"
            autocomplete="off">
          <button type="submit">+</button>
        </form>
        <p class="sidebar-toggle" data-target="my-channels"><span class="arrow">▾</span> MY CHANNELS</p>
        <ul id="my-channels">
          <% @my_channels.each do |ch| %>
            <%= render "chat/channel_link", ch: ch, active: @channel %>
          <% end %>
        </ul>
        <p class="sidebar-toggle collapsed" data-target="all-channels"><span class="arrow">▾</span> ALL CHANNELS</p>
        <ul id="all-channels" style="display:none">
          <% @all_channels.each do |ch| %>
            <%= render "chat/channel_link", ch: ch, active: @channel %>
          <% end %>
        </ul>
        <p class="sidebar-toggle" data-target="dm-list"><span class="arrow">▾</span> DIRECT MESSAGES</p>
        <ul id="dm-list" class="dm-list">
        </ul>
      </div>
      <div id="user-info">
        <%# App identity = SASL. OAuth credentials alone show "signing in". %>
        <% if @session.authenticated? %>
          <div class="user-handle" id="user-handle">🔒 <%= @session.auth_handle %></div>
          <div id="user-irc-note" class="user-irc-note" style="display:none;color:var(--muted);font-size:.65rem;margin-top:.15rem"></div>
          <div class="user-actions">
            <form method="POST" action="/logout" data-turbo="false" style="display:inline">
              <button type="submit" class="btn-link">Sign out</button>
            </form>
          </div>
        <% elsif @session.signing_in? %>
          <div class="user-handle signing-in" id="user-handle">⏳ <%= @session.auth_handle %></div>
          <div id="user-irc-note" class="user-irc-note" style="display:block;color:var(--muted);font-size:.65rem;margin-top:.15rem">Signing in to IRC (SASL)…</div>
          <div class="user-actions">
            <form method="POST" action="/logout" data-turbo="false" style="display:inline">
              <button type="submit" class="btn-link">Cancel</button>
            </form>
          </div>
        <% else %>
          <div class="user-handle guest" id="user-handle">👤 <%= @session.current_nick || "guest" %></div>
          <div id="user-irc-note" class="user-irc-note" style="display:none;color:var(--muted);font-size:.65rem;margin-top:.15rem"></div>
          <div class="user-actions">
            <a href="/login" class="btn-link">Sign in</a>
          </div>
        <% end %>
      </div>
    </aside>

    <%# Messages + compose — min-height:0 so #messages scrolls instead of growing. %>
    <section class="chat-main">
      <div id="messages" data-reflex-permanent>
        <%
          history_html, last_day = IrcRender.render_history_with_separators(
            @history,
            parent_lookup: @parent_lookup,
            own_nick: @own_nick,
            known_nicks: @known_nicks
          )
          @session.set_last_msg_day(@channel, last_day) if last_day
        %>
        <%= raw(history_html) %>
      </div>
      <div id="reply-banner" class="reply-banner" data-reflex-permanent></div>
      <div id="send-bar">
        <form id="send-form"
              data-reflex-permanent
              data-reflex="submit->ChatReflex#send_message"
              data-reflex-serialize-form="true"
              data-channel="<%= @bare %>"
              data-is-dm="<%= @is_dm ? "true" : "" %>">
          <input type="hidden" name="reply_to" id="reply-to-input" value="">
          <input type="hidden" name="edit_to" id="edit-to-input" value="">
          <input
            id="message-input"
            type="text"
            name="msg"
            placeholder="Send to <%= @channel %>…"
            autocomplete="off">
          <button type="submit">Send</button>
        </form>
      </div>
    </section>

    <%# Members — desktop column; mobile right sheet via .open.
        Live updates target #member-list only so the heading survives. %>
    <aside id="member-panel" data-reflex-permanent>
      <p class="drawer-heading">People</p>
      <div id="member-list">
        <% if @members_html %>
          <%= raw(@members_html) %>
        <% else %>
          <div class="member empty">—</div>
        <% end %>
      </div>
    </aside>
  </div>

  <div id="react-picker" role="menu" aria-label="React with emoji"></div>

  <div id="policy-modal" onclick="if(event.target===this)window.closePolicy()">
    <div class="policy-dialog">
      <div class="policy-header">
        <span class="policy-icon">🛡️</span>
        <span class="policy-title">Channel policy</span>
        <span id="policy-channel-name" class="policy-channel-name"></span>
        <button type="button" class="policy-close" onclick="window.closePolicy()" aria-label="Close">×</button>
      </div>
      <div id="policy-body" class="policy-content">
        <p class="policy-empty">Loading…</p>
      </div>
    </div>
  </div>
</div>