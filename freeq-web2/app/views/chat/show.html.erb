<%# Chat shell for a single channel. StimulusReflex handles mutations;
    CableReady broadcasts from the upstream IRC WS bridge morph/append. %>
<div id="freeq-chat"
     data-controller="chat"
     data-channel="<%= @bare %>"
     data-auth-handle="<%= @session.auth.is_a?(Hash) ? @session.auth[:nick] : "" %>"
     data-auth-did="<%= @session.authenticated? ? @session.auth.did : "" %>">
  <nav>
    <span class="brand">freeq</span>
    <span style="font-size:.875rem;color:#7ab7ff"><%= @channel %></span>
    <span id="channel-topic" title="Click to edit topic"
          style="margin-left:.5rem;font-size:.7rem;color:var(--muted);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:40%;min-width:4rem;cursor:pointer"><%= @topic.presence || "add topic" %></span>
    <form id="topic-form"
          data-reflex="submit->ChatReflex#set_topic"
          data-reflex-serialize-form="true"
          data-channel="<%= @bare %>"
          style="display:none;margin-left:.5rem;flex:0 1 40%;min-width:0">
      <input id="topic-input" type="text" name="topic"
             placeholder="Set topic… (Enter to save, Esc to cancel)"
             autocomplete="off"
             style="width:100%;font-size:.7rem;padding:2px 6px;border:1px solid var(--border);border-radius:4px;background:#151a22;color:var(--fg)">
    </form>
    <div class="nav-right">
      <span id="status"><span class="dot"></span> <span>connecting…</span></span>
    </div>
  </nav>

  <div class="chat-body">
    <%# Sidebar %>
    <aside id="sidebar" data-reflex-permanent>
      <div class="sidebar-scroll">
        <form id="join-form"
              data-reflex="submit->ChatReflex#join"
              data-reflex-serialize-form="true">
          <input
            type="text"
            name="channel"
            placeholder="join #…"
            autocomplete="off">
          <button type="submit">+</button>
        </form>
        <p class="sidebar-toggle" data-target="my-channels"><span class="arrow">▾</span> MY CHANNELS</p>
        <ul id="my-channels">
          <% @my_channels.each do |ch| %>
            <%= render "chat/channel_link", ch: ch, active: @channel %>
          <% end %>
        </ul>
        <p class="sidebar-toggle collapsed" data-target="all-channels"><span class="arrow">▾</span> ALL CHANNELS</p>
        <ul id="all-channels" style="display:none">
          <% @all_channels.each do |ch| %>
            <%= render "chat/channel_link", ch: ch, active: @channel %>
          <% end %>
        </ul>
        <p class="sidebar-toggle" data-target="dm-list"><span class="arrow">▾</span> DIRECT MESSAGES</p>
        <ul id="dm-list" class="dm-list">
        </ul>
      </div>
      <div id="user-info">
        <% if @session.authenticated? %>
          <div class="user-handle">🔒 <%= @session.auth_handle %></div>
          <div class="user-actions">
            <form method="POST" action="/logout" style="display:inline">
              <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
              <button type="submit" class="btn-link">Sign out</button>
            </form>
          </div>
        <% else %>
          <div class="user-handle guest">👤 <%= @session.current_nick || "guest" %></div>
          <div class="user-actions">
            <a href="/login" class="btn-link">Sign in</a>
          </div>
        <% end %>
      </div>
    </aside>

    <%# Messages + compose — min-height:0 so #messages scrolls instead of growing. %>
    <section class="chat-main">
      <div id="messages" data-reflex-permanent>
        <% @history.each do |msg| %>
          <%= raw(IrcRender.render_history_row(msg, parent_lookup: @parent_lookup, own_nick: @own_nick, known_nicks: @known_nicks)) %>
        <% end %>
      </div>
      <div id="reply-banner" class="reply-banner" data-reflex-permanent></div>
      <div id="send-bar">
        <form id="send-form"
              data-reflex-permanent
              data-reflex="submit->ChatReflex#send_message"
              data-reflex-serialize-form="true"
              data-channel="<%= @bare %>"
              data-is-dm="<%= @is_dm ? "true" : "" %>">
          <input type="hidden" name="reply_to" id="reply-to-input" value="">
          <input type="hidden" name="edit_to" id="edit-to-input" value="">
          <input
            id="message-input"
            type="text"
            name="msg"
            placeholder="Send to <%= @channel %>…"
            autocomplete="off">
          <button type="submit">Send</button>
        </form>
      </div>
    </section>

    <%# Members %>
    <aside id="member-panel" data-reflex-permanent>
      <% if @members_html %>
        <%= raw(@members_html) %>
      <% else %>
        <div style="color:var(--muted)">—</div>
      <% end %>
    </aside>
  </div>

  <div id="react-picker" role="menu" aria-label="React with emoji"></div>

  <div id="policy-modal" onclick="if(event.target===this)window.closePolicy()">
    <div class="policy-dialog">
      <div class="policy-header">
        <span class="policy-icon">🛡️</span>
        <span class="policy-title">Channel policy</span>
        <span id="policy-channel-name" class="policy-channel-name"></span>
        <button type="button" class="policy-close" onclick="window.closePolicy()" aria-label="Close">×</button>
      </div>
      <div id="policy-body" class="policy-content">
        <p class="policy-empty">Loading…</p>
      </div>
    </div>
  </div>
</div>