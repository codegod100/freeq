<%# Shared channel sidebar (MY CHANNELS / ALL / DMs + user footer).
    locals:
      active:     currently-viewed channel name (e.g. "#freeq") or nil on /chat
      with_voice: when true, include the voice-connected bar (call controller targets)
%>
<% active = local_assigns.fetch(:active, nil) %>
<% with_voice = local_assigns.fetch(:with_voice, false) %>
<aside id="sidebar" data-reflex-permanent>
  <p class="drawer-heading">Channels</p>
  <div class="sidebar-scroll">
    <form id="join-form"
          data-reflex="submit->ChatReflex#join"
          data-reflex-serialize-form="true">
      <input
        type="text"
        name="channel"
        placeholder="join #…"
        autocomplete="off">
      <button type="submit">+</button>
    </form>
    <p class="sidebar-toggle" data-target="my-channels"><span class="arrow">▾</span> MY CHANNELS</p>
    <ul id="my-channels">
      <% @my_channels.each do |ch| %>
        <%= render "chat/channel_link", ch: ch, active: active %>
      <% end %>
    </ul>
    <p class="sidebar-toggle collapsed" data-target="all-channels"><span class="arrow">▾</span> ALL CHANNELS</p>
    <ul id="all-channels" style="display:none">
      <% @all_channels.each do |ch| %>
        <%= render "chat/channel_link", ch: ch, active: active %>
      <% end %>
    </ul>
    <p class="sidebar-toggle" data-target="dm-list"><span class="arrow">▾</span> DIRECT MESSAGES</p>
    <ul id="dm-list" class="dm-list">
    </ul>
  </div>

  <% if with_voice %>
    <%# Persistent voice-connected bar — stays above user footer while in call. %>
    <div id="voice-connected"
         class="voice-connected"
         data-call-target="connectedBar"
         hidden>
      <div class="voice-connected-row">
        <span class="voice-connected-dot" aria-hidden="true"></span>
        <span class="voice-connected-title">Voice Connected</span>
        <button type="button"
                class="call-ctrl leave"
                data-action="click->call#leave"
                title="Disconnect"
                aria-label="Leave call">
          <svg viewBox="0 0 16 16" width="13" height="13" fill="currentColor" aria-hidden="true">
            <path d="M3.654 1.328a.678.678 0 0 0-1.015-.063L1.605 2.3c-.483.484-.661 1.169-.45 1.77a17.568 17.568 0 0 0 4.168 6.608 17.569 17.569 0 0 0 6.608 4.168c.601.211 1.286.033 1.77-.45l1.034-1.034a.678.678 0 0 0-.063-1.015l-2.307-1.794a.678.678 0 0 0-.58-.122l-2.19.547a1.745 1.745 0 0 1-1.657-.459L5.482 8.062a1.745 1.745 0 0 1-.46-1.657l.548-2.19a.678.678 0 0 0-.122-.58L3.654 1.328zM1.884.511a1.745 1.745 0 0 1 2.612.163L6.29 2.98c.329.423.445.974.315 1.494l-.547 2.19a.678.678 0 0 0 .178.643l2.457 2.457a.678.678 0 0 0 .644.178l2.189-.547a1.745 1.745 0 0 1 1.494.315l2.306 1.794c.829.645.905 1.87.163 2.611l-1.034 1.034c-.74.74-1.846 1.065-2.877.702a18.634 18.634 0 0 1-7.01-4.42 18.634 18.634 0 0 1-4.42-7.009c-.362-1.03-.037-2.137.703-2.877L1.885.511z" transform="rotate(135 8 8)"/>
          </svg>
        </button>
      </div>
      <div class="voice-connected-channel" data-call-target="connectedLabel"></div>
      <div class="voice-connected-ctrls">
        <button type="button"
                class="call-ctrl"
                data-call-target="micBtn"
                data-action="click->call#toggleMute"
                title="Mute"
                aria-label="Mute">
          <svg class="icon-mic" viewBox="0 0 16 16" width="15" height="15" fill="currentColor" aria-hidden="true">
            <path d="M3.5 6.5A.5.5 0 0 1 4 7v1a4 4 0 0 0 8 0V7a.5.5 0 0 1 1 0v1a5 5 0 0 1-4.5 4.975V15h3a.5.5 0 0 1 0 1h-7a.5.5 0 0 1 0-1h3v-2.025A5 5 0 0 1 3 8V7a.5.5 0 0 1 .5-.5z"/>
            <path d="M10 8a2 2 0 1 1-4 0V3a2 2 0 1 1 4 0v5zM8 0a3 3 0 0 0-3 3v5a3 3 0 0 0 6 0V3a3 3 0 0 0-3-3z"/>
          </svg>
          <svg class="icon-mic-off" viewBox="0 0 16 16" width="15" height="15" fill="currentColor" aria-hidden="true" hidden>
            <path d="M13 8c0 .564-.094 1.107-.266 1.613l-.814-.814A4.02 4.02 0 0 0 12 8V7a.5.5 0 0 1 1 0v1zm-5 4c.818 0 1.578-.245 2.212-.667l.718.719a4.973 4.973 0 0 1-2.43.923V15h3a.5.5 0 0 1 0 1h-7a.5.5 0 0 1 0-1h3v-2.025A5 5 0 0 1 3 8V7a.5.5 0 0 1 1 0v1a4 4 0 0 0 4 4zm3-9v4.879L5.158 2.037A3.001 3.001 0 0 1 11 3z"/>
            <path d="M9.486 10.607 5 6.12V8a3 3 0 0 0 4.486 2.607zm-7.84-1.96 1.442-1.442L14.96.33l.708.707L1.354 15.354l-.707-.707L4.14 11.153A4.985 4.985 0 0 1 3 8V7a.5.5 0 0 1 1 0v1c0 .455.076.897.216 1.306l.59-.59A4.02 4.02 0 0 1 4 8z"/>
          </svg>
        </button>
        <button type="button"
                class="call-ctrl"
                data-call-target="camBtn"
                data-action="click->call#toggleCamera"
                title="Turn on camera"
                aria-label="Camera">
          <svg viewBox="0 0 16 16" width="15" height="15" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M0 5a2 2 0 0 1 2-2h7.5a2 2 0 0 1 1.983 1.738l3.11-1.382A1 1 0 0 1 16 4.269v7.462a1 1 0 0 1-1.406.913l-3.111-1.382A2 2 0 0 1 9.5 13H2a2 2 0 0 1-2-2V5z"/>
          </svg>
        </button>
        <button type="button"
                class="voice-end-all"
                data-call-target="endBtn"
                data-action="click->call#endForAll"
                title="End session for everyone">End</button>
      </div>
    </div>
  <% end %>

  <div id="user-info">
    <%# App identity = SASL. OAuth credentials alone show "signing in". %>
    <% if @session.authenticated? %>
      <div class="user-handle" id="user-handle">🔒 <%= @session.auth_handle %></div>
      <div id="user-irc-note" class="user-irc-note" style="display:none;color:var(--muted);font-size:.65rem;margin-top:.15rem"></div>
      <div class="user-actions">
        <form method="POST" action="/logout" data-turbo="false" style="display:inline">
          <button type="submit" class="btn-link">Sign out</button>
        </form>
      </div>
    <% elsif @session.signing_in? %>
      <div class="user-handle signing-in" id="user-handle">⏳ <%= @session.auth_handle %></div>
      <div id="user-irc-note" class="user-irc-note" style="display:block;color:var(--muted);font-size:.65rem;margin-top:.15rem">Signing in to IRC (SASL)…</div>
      <div class="user-actions">
        <form method="POST" action="/logout" data-turbo="false" style="display:inline">
          <button type="submit" class="btn-link">Cancel</button>
        </form>
      </div>
    <% else %>
      <div class="user-handle guest" id="user-handle">👤 <%= @session.current_nick || "guest" %></div>
      <div id="user-irc-note" class="user-irc-note" style="display:none;color:var(--muted);font-size:.65rem;margin-top:.15rem"></div>
      <div class="user-actions">
        <a href="/login" class="btn-link">Sign in</a>
      </div>
    <% end %>
  </div>
</aside>
