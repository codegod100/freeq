<div class="flex h-dvh flex-col" data-controller="chat">
  <header class="flex items-center justify-between border-b border-[#232932] px-4 py-3">
    <div class="flex items-center gap-3">
      <span class="text-lg font-bold">freeq</span>
      <span class="text-sm text-zinc-500">channels</span>
    </div>
    <div class="flex items-center gap-3 text-sm">
      <a href="/login" class="text-[#7ab7ff] hover:underline">Sign in</a>
    </div>
  </header>
  <main class="flex-1 overflow-y-auto p-4">
    <form id="join-form" class="mb-4 flex gap-2" data-reflex-permanent>
      <input
        class="flex-1 rounded-lg border border-[#232932] bg-[#151a22] px-3 py-2 text-sm"
        type="text"
        name="channel"
        placeholder="join #channel"
        autocomplete="off"
        data-reflex="submit->ChatReflex#join">
      <button type="submit" class="rounded-lg bg-[#7ab7ff] px-3 py-2 text-sm font-semibold text-[#0e1116]">Join</button>
    </form>
    <ul class="space-y-1">
      <% @channels.each do |ch| %>
        <% bare = ch["name"].to_s.delete("#") %>
        <% href = "/chat/#{bare}" %>
        <li>
          <a href="<%= href %>" class="flex items-center justify-between rounded-lg px-3 py-2 text-sm hover:bg-[#151a22]">
            <span class="text-zinc-300"><%= ch["name"] %></span>
            <span class="text-xs text-zinc-500"><%= ch["members"] %></span>
          </a>
        </li>
      <% end %>
    </ul>
  </main>
</div>