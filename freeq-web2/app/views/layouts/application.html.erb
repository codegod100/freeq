<!DOCTYPE html>
<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=0">
    <meta name="theme-color" content="#0e1116">
    <meta name="mobile-web-app-capable" content="yes">
    <title>freeq</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
    <style>
      :root {
        --nick-1:#7ab7ff;--nick-2:#f78b6c;--nick-3:#c792ea;--nick-4:#ffd166;
        --nick-5:#06d6a0;--nick-6:#ef476f;--nick-7:#f4a261;--nick-8:#90e0ef;
        --self:#5cdb95;--bg:#0e1116;--fg:#d6d6d6;--muted:#6b7280;--border:#232932;
      }
      html,body{height:100dvh;max-height:100dvh;overflow:hidden;margin:0;background:var(--bg);color:var(--fg);font-family:system-ui,sans-serif}
      ::-webkit-scrollbar{width:6px}::-webkit-scrollbar-track{background:#1a1a2e}
      ::-webkit-scrollbar-thumb{background:#333;border-radius:3px}
      *{scrollbar-width:thin;scrollbar-color:#333 #1a1a2e;box-sizing:border-box}
      /* Layout shell (Tailwind utilities are not built — pure CSS here). */
      #freeq-chat{display:flex;flex-direction:column;height:100dvh;max-height:100dvh;overflow:hidden}
      #freeq-chat > nav{flex:0 0 auto;display:flex;align-items:center;gap:.5rem;border-bottom:1px solid var(--border);padding:.5rem}
      #freeq-chat > .chat-body{display:flex;flex:1 1 0;min-height:0;position:relative}
      #sidebar{flex:0 0 11rem;overflow-y:auto;border-right:1px solid var(--border);padding:.5rem;font-size:.75rem}
      #member-panel{flex:0 0 10rem;overflow-y:auto;border-left:1px solid var(--border);padding:.5rem;font-size:.75rem}
      #freeq-chat .chat-main{display:flex;flex-direction:column;flex:1 1 0;min-width:0;min-height:0}
      #messages{flex:1 1 0;min-height:0;overflow-y:auto;padding:.5rem .75rem}
      #reply-banner{flex:0 0 auto}
      #send-bar{flex:0 0 auto;display:flex;gap:.5rem;border-top:1px solid var(--border);padding:.5rem}
      #send-form{flex:1 1 auto;display:flex;gap:.5rem;min-width:0}
      #send-form input[type=text]{flex:1 1 auto;min-width:0;border:1px solid var(--border);background:#151a22;border-radius:.5rem;padding:.5rem .75rem;font-size:.875rem;color:var(--fg);outline:none}
      #send-form input[type=text]:focus{border-color:#7ab7ff}
      #send-form input[type=text]::placeholder{color:var(--muted)}
      #send-form button[type=submit]{flex:0 0 auto;border:0;border-radius:.5rem;background:#7ab7ff;padding:.5rem .75rem;font-size:.875rem;font-weight:600;color:#0e1116;cursor:pointer}
      #send-form button[type=submit]:hover{background:#9cc8ff}
      #messages .msg{display:grid;grid-template-columns:48px 1fr;gap:.3rem;padding:1px 0;font-size:.8rem}
      #messages .ts{color:var(--muted);font-size:.65rem;text-align:right;user-select:none}
      #messages .body{white-space:pre-wrap;overflow-wrap:anywhere}
      #messages .nick{font-weight:600}
      .nick.n1{color:var(--nick-1)}.nick.n2{color:var(--nick-2)}.nick.n3{color:var(--nick-3)}.nick.n4{color:var(--nick-4)}
      .nick.n5{color:var(--nick-5)}.nick.n6{color:var(--nick-6)}.nick.n7{color:var(--nick-7)}.nick.n8{color:var(--nick-8)}
      #messages .notice{color:var(--muted);font-style:italic;padding:2px 0}
      #messages .join .body{color:var(--nick-5)}#messages .part .body{color:var(--nick-6)}
      #member-panel .pfx.op{color:var(--self)}
      #status .dot{display:inline-block;width:6px;height:6px;border-radius:50%;background:var(--muted);margin-right:4px}
      #status.connected .dot{background:var(--self);box-shadow:0 0 5px var(--self)}
      #messages a{color:#7ab7ff}
      .reactions{display:inline-flex;flex-wrap:wrap;gap:3px;margin-left:6px;vertical-align:middle}
      .reaction-chip{display:inline-flex;align-items:center;gap:2px;padding:1px 6px;background:rgba(255,255,255,.07);border:1px solid var(--border);border-radius:999px;font-size:.75rem;cursor:pointer}
      .react-btn{opacity:.5;border:1px dashed var(--border);border-radius:999px;width:1.2rem;height:1.2rem;background:transparent;color:var(--muted);cursor:pointer}
      #messages .msg:hover .react-btn{opacity:1}
      #messages .msg:hover .reply-btn{opacity:1}
      .reply-badge{display:flex;align-items:center;gap:6px;width:100%;margin:0 0 2px;padding:1px 0 1px 6px;border:0;border-left:2px solid rgba(122,183,255,.35);background:transparent;color:var(--muted);font-size:.7rem;text-align:left;cursor:pointer}
      .reply-badge:hover{background:rgba(122,183,255,.06)}
      .reply-badge .reply-nick{font-weight:600;color:#9ca3af}
      .reply-badge .reply-text{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:280px}
      .reply-btn{opacity:0;border:0;background:transparent;color:var(--muted);cursor:pointer;padding:0 4px;font-size:.75rem;margin-left:4px}
      .reply-btn:hover{color:#7ab7ff}
      .reply-banner:empty{display:none}
      .reply-banner{display:flex;align-items:center;gap:8px;padding:6px 12px;border-top:1px solid var(--border);background:#151a22;font-size:.75rem;color:var(--muted)}
      .reply-banner .reply-banner-label{color:#7ab7ff;font-weight:600}
      .reply-banner .reply-banner-text{flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
      .reply-banner .reply-banner-cancel{border:0;background:transparent;color:var(--muted);cursor:pointer;font-size:1rem;padding:0 4px}
      .reply-banner .reply-banner-cancel:hover{color:#fff}
      #messages .msg.highlight{background:rgba(122,183,255,.12);transition:background .8s ease}
      #react-picker{position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);display:none;z-index:100;background:var(--bg);border:1px solid var(--border);border-radius:.5rem;padding:.4rem;gap:4px}
      #react-picker.open{display:flex}
      #react-picker button{background:transparent;border:0;padding:.25rem .4rem;font-size:1.25rem;cursor:pointer}
      @media(max-width:1024px){
        #sidebar,#member-panel{position:fixed;top:0;bottom:0;width:260px;max-width:80vw;background:var(--bg);z-index:100;transition:transform .2s ease}
        #sidebar{left:0;transform:translateX(-110%);border-right:1px solid var(--border);flex:none}
        #member-panel{right:0;transform:translateX(110%);border-left:1px solid var(--border);flex:none}
        #sidebar.open,#member-panel.open{transform:translateX(0)}
        .mobile-btn{display:flex!important}
      }

      /* ── Channel list page ─────────────────────────────────── */
      .channel-list-page{flex:1;overflow-y:auto;padding:1rem 1.25rem;max-width:42rem;margin:0 auto;width:100%}

      .channel-list-page #join-form{display:flex;gap:.5rem;margin-bottom:1rem}
      .channel-list-page #join-form input{
        flex:1;min-width:0;border:1px solid var(--border);background:#151a22;
        border-radius:.5rem;padding:.5rem .75rem;font-size:.875rem;color:var(--fg);
        outline:none;transition:border-color .15s
      }
      .channel-list-page #join-form input:focus{border-color:#7ab7ff}
      .channel-list-page #join-form input::placeholder{color:var(--muted)}
      .channel-list-page #join-form button{
        border:0;border-radius:.5rem;background:#7ab7ff;padding:.5rem 1rem;
        font-size:.875rem;font-weight:600;color:#0e1116;cursor:pointer;
        transition:background .15s
      }
      .channel-list-page #join-form button:hover{background:#9cc8ff}

      .channel-list{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:2px}
      .channel-item{
        display:flex;align-items:center;gap:.75rem;padding:.625rem .75rem;
        border-radius:.5rem;text-decoration:none;color:var(--fg);
        transition:background .12s
      }
      .channel-item:hover{background:#151a22}
      .channel-name{font-weight:600;font-size:.875rem;flex-shrink:0}
      .channel-topic{
        flex:1;min-width:0;font-size:.75rem;color:var(--muted);
        overflow:hidden;text-overflow:ellipsis;white-space:nowrap
      }
      .channel-members{
        flex-shrink:0;font-size:.7rem;color:var(--muted);
        background:#1a1f28;border-radius:.25rem;padding:.125rem .375rem;
        min-width:1.5rem;text-align:center
      }
      .empty-state{color:var(--muted);font-size:.875rem;text-align:center;padding:2rem 0}

      /* ── Nav bar (shared between chat + channel list) ─────── */
      #freeq-chat > nav .brand{font-size:.875rem;font-weight:700}
      #freeq-chat > nav .page-title{font-size:.875rem;color:var(--muted)}
      #freeq-chat > nav .nav-right{margin-left:auto;display:flex;align-items:center;gap:.5rem;font-size:.75rem}
      .auth-badge{color:var(--nick-5)}
      .btn-link{border:0;background:transparent;color:var(--muted);cursor:pointer;font-size:.75rem;text-decoration:none;padding:0}
      .btn-link:hover{color:var(--fg)}
      a.btn-link{color:#7ab7ff}
      a.btn-link:hover{color:#9cc8ff}

      /* ── Sidebar ─────────────────────────────────────────── */
      #sidebar #join-form{display:flex;gap:.25rem;margin-bottom:.5rem}
      #sidebar #join-form input{
        min-width:0;flex:1;border:1px solid var(--border);background:#151a22;
        border-radius:.25rem;padding:.125rem .375rem;font-size:.75rem;color:var(--fg);
        outline:none
      }
      #sidebar #join-form input:focus{border-color:#7ab7ff}
      #sidebar #join-form input::placeholder{color:var(--muted)}
      #sidebar #join-form button{
        border:0;border-radius:.25rem;background:#7ab7ff;color:#0e1116;
        font-weight:600;padding:.125rem .5rem;font-size:.75rem;cursor:pointer
      }
      #sidebar #join-form button:hover{background:#9cc8ff}
      .sidebar-toggle{
        margin:0 0 .25rem;padding:0 .25rem;font-size:.65rem;
        letter-spacing:.04em;color:var(--muted);cursor:pointer;user-select:none
      }
      .sidebar-toggle:hover{color:var(--fg)}
      #my-channels,#all-channels{list-style:none;margin:0;padding:0}
      #my-channels{margin-bottom:.75rem}

      /* ── Sidebar channel list ─────────────────────────────── */
      .sidebar-channel{display:flex;align-items:center;gap:.25rem;padding:0 .25rem}
      .sidebar-channel-link{
        flex:1;min-width:0;display:block;border-radius:.25rem;
        padding:.125rem .375rem;font-size:.75rem;color:var(--fg);
        text-decoration:none;overflow-wrap:anywhere;transition:background .12s
      }
      .sidebar-channel-link:hover{background:#151a22}
      .sidebar-channel.active .sidebar-channel-link{
        background:#7ab7ff;color:#0e1116;font-weight:500
      }
      .sidebar-channel-count{
        flex-shrink:0;border:0;border-radius:.25rem;background:#1a1f28;
        padding:.0625rem .375rem;font-size:.65rem;color:var(--muted);
        cursor:pointer;transition:color .12s
      }
      .sidebar-channel-count:hover{color:var(--fg)}
      .sidebar-channel-part{
        flex-shrink:0;border:0;background:transparent;color:var(--muted);
        font-size:.85rem;line-height:1;padding:0 .25rem;cursor:pointer;
        opacity:0;transition:opacity .12s,color .12s
      }
      .sidebar-channel:hover .sidebar-channel-part{opacity:1}
      .sidebar-channel-part:hover{color:var(--nick-6)}

      /* ── Policy modal ─────────────────────────────────────── */
      #policy-modal{
        display:none;position:fixed;inset:0;z-index:120;
        align-items:center;justify-content:center;background:rgba(0,0,0,.7)
      }
      #policy-modal.open{display:flex}
      .policy-dialog{
        margin:0 1rem;width:100%;max-width:28rem;border-radius:.75rem;
        border:1px solid var(--border);background:#151a22;padding:1.25rem;
        box-shadow:0 8px 32px rgba(0,0,0,.4)
      }
      .policy-header{display:flex;align-items:center;gap:.5rem;margin-bottom:.75rem}
      .policy-icon{font-size:1rem}
      .policy-title{font-weight:600;font-size:.875rem;color:var(--fg)}
      .policy-channel-name{
        border-radius:.25rem;background:#1a1f28;padding:.125rem .375rem;
        font-size:.65rem;color:var(--muted);font-family:monospace
      }
      .policy-close{
        margin-left:auto;border:0;background:transparent;color:var(--muted);
        font-size:1.25rem;line-height:1;padding:0 .25rem;cursor:pointer
      }
      .policy-close:hover{color:var(--fg)}
      .policy-content{font-size:.875rem;color:var(--fg);max-height:70vh;overflow-y:auto}
      .policy-empty{color:var(--muted);font-size:.875rem}
      .policy-open{color:var(--fg);font-size:.875rem}
      .policy-open-sub{color:var(--muted);font-size:.75rem}
      .policy-section{margin-bottom:.75rem}
      .policy-bordered{padding-top:.75rem;border-top:1px solid var(--border)}
      .policy-heading{
        font-size:.65rem;font-weight:600;text-transform:uppercase;
        letter-spacing:.04em;color:var(--muted);margin:0 0 .375rem
      }
      .policy-rules-text{
        font-size:.875rem;color:var(--fg);white-space:pre-wrap;
        line-height:1.5;margin:0
      }
      .policy-hash{font-size:.65rem;font-family:monospace;color:var(--muted);margin:.25rem 0 0}
      .policy-dl{display:grid;grid-template-columns:auto 1fr;gap:.125rem .75rem;font-size:.75rem;margin:0}
      .policy-dt{color:var(--muted)}
      .policy-dd{color:var(--fg);margin:0}
      .policy-mono{font-family:monospace;font-size:.7rem;word-break:break-all}
      .policy-roles{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:.375rem}
      .policy-role{
        border-radius:.5rem;border:1px solid var(--border);
        background:var(--bg);padding:.5rem .625rem
      }
      .policy-role-header{display:flex;align-items:center;gap:.375rem;font-size:.75rem}
      .policy-role-icon{color:#ffd166}
      .policy-role-name{font-weight:500;color:var(--fg)}
      .policy-role-mode{font-size:.65rem;font-family:monospace;color:#ffd166;opacity:.8;margin-left:.25rem}
      .policy-role-req{font-size:.7rem;color:var(--muted);margin:.125rem 0 0;padding-left:1.25rem}
    </style>
  </head>
  <body class="h-full">
    <%= yield %>
    <script>
      // Policy modal — standalone, no Stimulus dependency.
      window.showPolicy = async function (ch) {
        var modal = document.getElementById("policy-modal");
        if (!modal) return;
        var nameEl = document.getElementById("policy-channel-name");
        var bodyEl = document.getElementById("policy-body");
        if (nameEl) nameEl.textContent = "#" + String(ch || "").replace(/^#/, "");
        if (bodyEl) bodyEl.innerHTML = '<p class="policy-empty">Loading…</p>';
        modal.classList.add("open");
        try {
          var r = await fetch("/api/policy/" + encodeURIComponent(ch));
          var html = await r.text();
          if (bodyEl) bodyEl.innerHTML = html;
        } catch (e) {
          if (bodyEl) bodyEl.innerHTML = '<p class="policy-empty">Failed to load policy.</p>';
        }
      };
      window.closePolicy = function () {
        var modal = document.getElementById("policy-modal");
        if (modal) modal.classList.remove("open");
      };
      document.addEventListener("keydown", function (e) {
        if (e.key === "Escape") window.closePolicy();
      });
    </script>
  </body>
</html>