source "https://rubygems.org"

gem "rails", "~> 8.1.3"
gem "propshaft"
gem "puma", ">= 5.0"
gem "jsbundling-rails"
gem "turbo-rails"
gem "stimulus-rails"
gem "cssbundling-rails"

# StimulusReflex + CableReady — the whole point of this port.
gem "stimulus_reflex", "~> 3.5"
gem "cable_ready", "~> 5.0"

# WebSocket client for the upstream IRC bridge. websocket-driver is already
# pulled in by ActionCable; we use it client-side over a raw TCPSocket so we
# avoid any extra native-extension dependencies (async-websocket drags in a
# native openssl gem that doesn't build on this Nix host).
gem "websocket-driver"

gem "bootsnap", require: false
gem "thruster", require: false

# AT Protocol OAuth: ed25519 for DPoP proofs, base64 for URL-safe encoding.
gem "ed25519", "~> 1.3"
gem "base64", "~> 0.2"

group :development, :test do
  gem "debug", platforms: %i[ mri windows ], require: "debug/prelude"
end

group :development do
  gem "web-console"
end